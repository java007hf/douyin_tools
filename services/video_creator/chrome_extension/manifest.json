{
  "manifest_version": 3,
  "name": "Doubao Upload Bridge",
  "version": "0.1.10",
  "description": "Verify native Doubao signed uploads with a local Python transport.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.doubao.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["https://www.doubao.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start"},
    {"matches": ["https://www.doubao.com/*"], "js": ["content.js"], "run_at": "document_start"}
  ]
}
